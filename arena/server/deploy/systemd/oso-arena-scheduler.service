[Unit]
Description=oso Arena scheduler (pairing, tournaments, replay cache, housekeeping)
After=oso-arena-web.service

[Service]
User=oso-arena
Group=oso-arena
EnvironmentFile=/etc/oso-arena/arena.env
ExecStart=/opt/oso-arena/venv/bin/python -m osoarena.scheduler
Restart=always
RestartSec=5
UMask=0027
ReadWritePaths=/var/lib/oso-arena
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
MemoryMax=512M
TasksMax=32
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
